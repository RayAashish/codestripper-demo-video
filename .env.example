# Remotion Studio & Rendering Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local environments.

# Remotion Studio preview server port
PORT=3000

# Headless renderer thread concurrency (default: auto or CPU count)
REMOTION_CONCURRENCY=8

# Video rendering image format (jpeg or png)
REMOTION_IMAGE_FORMAT=jpeg

# Studio telemetry and auto-open behavior (true/false)
REMOTION_STUDIO_NO_OPEN=false
